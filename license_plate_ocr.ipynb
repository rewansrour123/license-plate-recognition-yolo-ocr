from ultralytics import YOLO
from IPython.display import display
from PIL import Image
import glob
import os

model = YOLO("/content/runs/detect/train/weights/best.pt")

image_path = "/content/images (1).jpg"

results = model.predict(
    source=image_path,
    conf=0.25,
    save=True
)

